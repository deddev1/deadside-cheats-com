{
  "name": "Deadside Cheats",
  "install": "npm ci && npm run build",
  "start": "npm run dev",
  "ports": [
    {
      "name": "Deadside Cheats dev",
      "port": 3000
    },
    {
      "name": "Deadside Cheats preview",
      "port": 4321
    }
  ],
  "terminals": [
    {
      "name": "localhost",
      "command": "npm run dev",
      "description": "Dev server — http://localhost:3000 (hot reload)"
    },
    {
      "name": "preview",
      "command": "npm run preview",
      "description": "Production preview — http://localhost:4321 (built dist/)"
    }
  ]
}
