---
import { productScreenshots } from '../data/product-images';
import { contentSrcSet } from '../lib/responsive-images';

interface Props {
	caption: string;
	scrollLabel: string;
}

const { caption, scrollLabel } = Astro.props;
const galleryId = `home-about-gallery-${Math.random().toString(36).slice(2, 9)}`;
---

<figure class="home-about-gallery">
	<div
		id={galleryId}
		class="home-about-gallery__scroller"
		role="region"
		aria-roledescription="carousel"
		aria-label={scrollLabel}
		tabindex="0"
	>
		{
			productScreenshots.map((shot, index) => (
				<div
					class="home-about-gallery__slide"
					role="group"
					aria-roledescription="slide"
					aria-label={`${index + 1} of ${productScreenshots.length}`}
				>
					<img
						class="home-about-gallery__img"
						src={shot.src}
						srcset={contentSrcSet(shot.src)}
						sizes="(min-width: 56rem) 34rem, 100vw"
						alt={shot.alt}
						width="960"
						height="540"
						loading={index === 0 ? 'eager' : 'lazy'}
						decoding="async"
						draggable="false"
					/>
				</div>
			))
		}
	</div>
	<figcaption class="home-about-gallery__caption">{caption}</figcaption>
</figure>

<script>
	function initHomeAboutGalleries() {
		document.querySelectorAll('.home-about-gallery__scroller').forEach((scroller) => {
			if (scroller.dataset.galleryInit === 'true') return;
			scroller.dataset.galleryInit = 'true';

			const slides = scroller.querySelectorAll('.home-about-gallery__slide');
			if (slides.length < 2) return;

			const scrollToSlide = (index) => {
				const slide = slides[index];
				if (!slide) return;
				const offset = slide.offsetLeft - (scroller.clientWidth - slide.clientWidth) / 2;
				scroller.scrollTo({ left: offset, behavior: 'smooth' });
			};

			let activeIndex = 0;
			const syncActive = () => {
				const center = scroller.scrollLeft + scroller.clientWidth / 2;
				let nearest = 0;
				let nearestDist = Number.POSITIVE_INFINITY;
				slides.forEach((slide, i) => {
					const slideCenter = slide.offsetLeft + slide.clientWidth / 2;
					const dist = Math.abs(slideCenter - center);
					if (dist < nearestDist) {
						nearestDist = dist;
						nearest = i;
					}
				});
				activeIndex = nearest;
			};

			scroller.addEventListener('scroll', () => {
				window.requestAnimationFrame(syncActive);
			}, { passive: true });

			scroller.addEventListener('keydown', (event) => {
				if (event.key === 'ArrowRight') {
					event.preventDefault();
					scrollToSlide(Math.min(activeIndex + 1, slides.length - 1));
				} else if (event.key === 'ArrowLeft') {
					event.preventDefault();
					scrollToSlide(Math.max(activeIndex - 1, 0));
				}
			});
		});
	}

	initHomeAboutGalleries();
	document.addEventListener('astro:page-load', initHomeAboutGalleries);
</script>

<style>
	.home-about-gallery {
		margin: 0;
		width: 100%;
	}

	.home-about-gallery__scroller {
		display: flex;
		gap: 0;
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow-x: auto;
		overflow-y: hidden;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		-webkit-overflow-scrolling: touch;
		overscroll-behavior-x: contain;
		border-radius: var(--radius-md);
		border: 1px solid var(--line);
		background: var(--bg-elevated);
		box-shadow: 0 12px 40px color-mix(in srgb, var(--bg) 55%, transparent);
		scrollbar-width: thin;
		scrollbar-color: color-mix(in srgb, var(--magenta) 55%, transparent) transparent;
	}

	.home-about-gallery__scroller:focus-visible {
		outline: 2px solid var(--magenta);
		outline-offset: 2px;
	}

	.home-about-gallery__scroller::-webkit-scrollbar {
		height: 0.45rem;
	}

	.home-about-gallery__scroller::-webkit-scrollbar-thumb {
		border-radius: 999px;
		background: color-mix(in srgb, var(--magenta) 55%, transparent);
	}

	.home-about-gallery__scroller::-webkit-scrollbar-track {
		background: color-mix(in srgb, var(--bg) 80%, transparent);
	}

	.home-about-gallery__slide {
		flex: 0 0 100%;
		min-width: 100%;
		height: 100%;
		scroll-snap-align: center;
		scroll-snap-stop: always;
	}

	.home-about-gallery__img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		background: var(--bg-elevated);
		user-select: none;
		-webkit-user-drag: none;
	}

	.home-about-gallery__caption {
		margin: 0.55rem 0 0;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--ink-faint);
		text-align: center;
	}
</style>
