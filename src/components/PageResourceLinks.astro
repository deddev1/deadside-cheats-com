---
import { getLocalizedPath } from '../data/i18n/routing';
import type { LocaleCode } from '../data/i18n/locales';
import { getT } from '../i18n/server';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const t = getT(locale);

const links = [
	{ href: getLocalizedPath('features', locale), labelKey: 'pageResources.linkFeatures' as const },
	{ href: getLocalizedPath('pricing', locale), labelKey: 'pageResources.linkPricing' as const },
	{ href: getLocalizedPath('setup', locale), labelKey: 'pageResources.linkSetup' as const },
	{ href: getLocalizedPath('updates', locale), labelKey: 'pageResources.linkUpdates' as const },
	{ href: getLocalizedPath('faq', locale), labelKey: 'pageResources.linkFaq' as const },
	{ href: '/blog/', labelKey: 'pageResources.linkBlog' as const },
];
---

<section class="card-panel page-resources">
	<h2>{t('pageResources.title')}</h2>
	<p>{t('pageResources.lede')}</p>
	<p>{t('pageResources.detail')}</p>
	<ul class="page-resources__list">
		{
			links.map((link) => (
				<li>
					<a href={link.href}>{t(link.labelKey)}</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	.page-resources__list {
		margin: 0.85rem 0 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.45rem;
	}

	.page-resources__list a {
		color: var(--link);
		font-weight: 600;
		text-decoration: none;
	}

	.page-resources__list a:hover {
		color: var(--accent-hover);
	}
</style>
