---
import RedirectPage from '../../../components/RedirectPage.astro';
import { defaultLocale, isLocaleCode, localeCodes } from '../../../data/i18n/locales';

export function getStaticPaths() {
	return localeCodes
		.filter((code) => code !== defaultLocale)
		.map((lang) => ({ params: { lang } }));
}

if (!isLocaleCode(Astro.params.lang ?? '')) {
	return Astro.redirect('/blog/', 301);
}

const lang = Astro.params.lang ?? '';
---

<RedirectPage
	to="/blog/"
	canonicalPath="/blog/"
	title={`${lang.toUpperCase()} blog redirect | Deadside Cheats`}
/>
